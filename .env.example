# Modelo de configuração do Concilia. Copie para .env e ajuste.
# Valores abaixo são de DESENVOLVIMENTO. Em produção: NODE_ENV=production e COOKIE_SECURE=true.

# --- Ambiente e servidor ---
# Ambiente de execução: development, test ou production.
NODE_ENV=development
# Endereço de escuta do servidor HTTP.
HOST=0.0.0.0
# Porta do servidor HTTP.
PORT=3000
# Nível de log: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
# Nome exibido na interface e nos relatórios.
PRODUCT_NAME=Concilia
# multi = várias empresas na mesma instalação; single = uma empresa só.
DEPLOYMENT_MODE=multi

# --- Banco de dados ---
# Conexão do papel da aplicação (sujeito a RLS). Em Docker Compose, troque localhost por db.
DATABASE_URL=postgres://concilia_app:concilia_app@localhost:5432/concilia
# Conexão do papel dono do esquema, usada só para migrações e backup.
MIGRATION_DATABASE_URL=postgres://concilia_owner:concilia_owner@localhost:5432/concilia
# Nome do papel do PostgreSQL usado pela aplicação.
DB_APP_ROLE=concilia_app
# Número máximo de conexões no pool do banco (1 a 100).
DB_POOL_MAX=10

# --- Sessão e segredos ---
# Segredo de assinatura das sessões (mínimo de 32 caracteres). Gere com: openssl rand -hex 32
SESSION_SECRET=TROQUE-ESTE-VALOR
# Chave mestra de 32 bytes em base64 para cifrar segredos. Gere com: openssl rand -base64 32
SECRETS_MASTER_KEY=TROQUE-ESTE-VALOR
# Versão da chave mestra, usada na rotação de segredos.
SECRETS_KEY_VERSION=1
# Cookie só é enviado por HTTPS. Obrigatório true em produção.
COOKIE_SECURE=false
# Validade máxima de uma sessão, em horas.
SESSION_ABSOLUTE_HOURS=12

# --- Login ---
# Tentativas erradas antes de bloquear a conta temporariamente (3 a 20).
LOGIN_MAX_ATTEMPTS=5
# Duração do bloqueio após tentativas erradas, em minutos.
LOGIN_LOCK_MINUTES=15
# Custo do scrypt em log2 (10 a 20). Em produção, 15 ou mais; 17 é o recomendado.
PASSWORD_SCRYPT_COST=17
# Limite de requisições por IP. false só para depuração.
RATE_LIMIT_ENABLED=true
# Confia no cabeçalho X-Forwarded-* de um proxy reverso à frente da aplicação.
TRUST_PROXY=false

# --- Trabalhos em segundo plano ---
# Executa os trabalhos de fila dentro deste processo.
WORKER_ENABLED=true
# Intervalo entre consultas da fila, em milissegundos.
WORKER_POLL_MS=1000
# Trabalhos executados em paralelo (1 a 16).
WORKER_CONCURRENCY=2
# Tempo máximo de um trabalho antes de ser interrompido, em segundos.
JOB_TIMEOUT_SECONDS=600

# --- Importação e integrações ---
# Tamanho máximo de um arquivo enviado, em MB.
MAX_UPLOAD_MB=15
# Número máximo de linhas aceitas em uma importação.
MAX_IMPORT_ROWS=100000
# Permite integrações com endereços privados. Nunca em produção; apenas para testes locais.
ALLOW_PRIVATE_INTEGRATION_HOSTS=false

# --- Observabilidade e arquivos estáticos ---
# Token exigido no endpoint de métricas (opcional). Gere com: openssl rand -hex 32
METRICS_TOKEN=
# Pasta com o build do front-end servido pela API (opcional; vazio desliga).
WEB_DIST_DIR=
