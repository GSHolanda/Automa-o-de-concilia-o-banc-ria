{
  "name": "concilia",
  "private": true,
  "version": "0.1.0",
  "description": "Concilia — plataforma multiempresa de conciliação bancária",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @concilia/web build && pnpm --filter @concilia/api build",
    "dev:api": "pnpm --filter @concilia/api dev",
    "dev:web": "pnpm --filter @concilia/web dev",
    "db:migrate": "pnpm --filter @concilia/api cli db:migrate",
    "cli": "pnpm --filter @concilia/api cli",
    "worker": "pnpm --filter @concilia/api worker",
    "test:e2e": "pnpm --filter @concilia/e2e test"
  }
}
